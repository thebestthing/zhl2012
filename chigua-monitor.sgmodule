#!name=吃瓜监控（黑料不打烊 + 51吃瓜）
#!desc=每30分钟监控黑料不打烊和51吃瓜，有新内容带封面图推送；另附图片测试脚本可手动运行
#!category=娱乐

[Script]
吃瓜监控 = type=cron,cronexp=*/30 * * * *,wake-system=1,timeout=180,script-path=https://raw.githubusercontent.com/thebestthing/zhl2012/main/chigua.js,script-update-interval=0
吃瓜图片测试 = type=generic,script-path=https://raw.githubusercontent.com/thebestthing/zhl2012/main/chigua-test.js
