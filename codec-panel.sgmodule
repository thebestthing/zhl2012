#!name=Codec 硬件监控面板
#!desc=在 Surge 面板显示 Codec 工具箱里 Windows 电脑的硬件状态（CPU/内存/显卡/磁盘/温度/网络/电池）。启用前先在参数里填 SHARECODE 和 TOKEN（见参数说明）。token 相当于密码，参数只存在你本机，不要外传。
#!category=面板
#!arguments=SHARECODE:"XXXX",TOKEN:"YYYY"
#!arguments-desc=SHARECODE:\n打开你的硬件监控页面，地址栏里 ?sharecode= 后面那串就是它。\nTOKEN:\n地址栏里 &token= 后面那串就是它。相当于密码，只保存在你本机 Surge 里，不要外传、不要发截图。

[Script]
Codec硬件监控 = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/thebestthing/zhl2012/main/codec-panel-v2.js, argument=https://a5e2443ba5e502256.app.workbuddy.host/api/snapshot?sharecode={{{SHARECODE}}}&token={{{TOKEN}}}

[Panel]
Codec硬件监控 = script-name=Codec硬件监控, title="Windows 硬件监控", content="加载中…", style=info, update-interval=60
