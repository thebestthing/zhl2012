#!name=Codec 硬件监控面板
#!desc=在 Surge 面板显示 Codec 工具箱里 Windows 电脑的硬件状态（CPU/内存/显卡/磁盘/温度/网络/电池）。使用前必须改参数：把下面脚本的 argument 改成你的监控接口完整地址——打开你的硬件监控页面，地址栏是 https://域名/?sharecode=...&token=...，在域名后、问号前插入 /api/snapshot 即是。该地址含 token，相当于密码，只存在你本机，不要外传。
#!category=面板

[Script]
Codec硬件监控 = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/thebestthing/zhl2012/main/codec-panel.js, argument=https://example.com/api/snapshot?sharecode=XXXX&token=YYYY

[Panel]
Codec硬件监控 = script-name=Codec硬件监控, title="Windows 硬件监控", content="加载中…", style=info, update-interval=60
